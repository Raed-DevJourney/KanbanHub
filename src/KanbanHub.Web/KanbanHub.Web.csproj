<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The board UI: Blazor WebAssembly, served as static files (Azure Static Web Apps). -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KanbanHub.Contracts\KanbanHub.Contracts.csproj" />
  </ItemGroup>

  <!-- The local-development sign-in (personas of tools/KanbanHub.DevHost) and the settings that switch it on
       exist in Debug builds only. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Development\**" />
    <Content Remove="Development\**" />
    <Content Remove="wwwroot\appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KanbanHub.Web.Tests" />
  </ItemGroup>

</Project>
