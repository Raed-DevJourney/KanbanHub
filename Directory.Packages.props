<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Identity">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup Label="Functions">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.SignalR.Management" Version="1.34.0" />
  </ItemGroup>

  <ItemGroup Label="GitHub">
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="AI">
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Authentication.WebAssembly.Msal" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>

</Project>
