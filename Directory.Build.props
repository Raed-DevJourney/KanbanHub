<Project>

  <!-- Applies to every C# project. The SQL project (.sqlproj) brings its own target framework. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- XML docs are generated so the IDE style rules run in the build; CS1591 stays off so
         comments are written where they add information rather than on every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- The Functions SDK prepares its extension project in a step that runs after a function project's own
         restore. Restoring the solution, or a project that references a function app, never runs that step,
         so the SDK does the work during the first build instead and reports AZFW0108. The result is the same;
         as a warning it would fail every clean checkout, so it is not reported. -->
    <NoWarn>$(NoWarn);AZFW0108</NoWarn>
  </PropertyGroup>

</Project>
